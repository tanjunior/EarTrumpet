<UserControl x:Class="EarTrumpet.UI.Views.VirtualMixerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:Theme="clr-namespace:EarTrumpet.UI.Themes"
             xmlns:ctl="clr-namespace:EarTrumpet.UI.Controls"
             xmlns:conv="clr-namespace:EarTrumpet.UI.Converters"
             IsTabStop="False">
    <UserControl.Resources>
        <conv:VolumeToStringConverter x:Key="VolumeToStringConverter" />
        <Style x:Key="RouteToggleStyle" TargetType="ToggleButton">
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Margin" Value="3,0,0,0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Opacity" Value="0.6" />
            <Setter Property="Theme:Brush.Foreground" Value="Text" />
            <Setter Property="Theme:Brush.BorderBrush" Value="Text" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Padding="5,0,5,1"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Opacity" Value="1" />
                    <Setter Property="Theme:Brush.Background" Value="SystemAccent" />
                    <Setter Property="Theme:Brush.BorderBrush" Value="SystemAccent" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="1" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <UserControl.Style>
        <Style TargetType="UserControl">
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasStrips}" Value="False">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Style>
    <Border Theme:Brush.Background=":=Background, Flyout:FlyoutBackground">
        <StackPanel>
            <Border Height="{DynamicResource Mutable_DeviceTitleCellHeight}" Margin="{StaticResource WindowMargin}">
                <TextBlock Style="{StaticResource DeviceTitleTextStyle}"
                           Text="{Binding DisplayName}"
                           TextTrimming="CharacterEllipsis" />
            </Border>
            <ItemsControl Margin="{StaticResource VolumeAppListMargin}"
                          Focusable="False"
                          IsTabStop="False"
                          ItemsSource="{Binding Strips}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Background="Transparent">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{DynamicResource Mutable_IconCellWidth}" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="{DynamicResource Mutable_VolumeCellWidth}" />
                            </Grid.ColumnDefinitions>

                            <!-- Sizes the slider row. Mutable_AppItemCellHeight is a double, so it can't be a RowDefinition height. -->
                            <Border Grid.Row="1"
                                    Grid.ColumnSpan="3"
                                    Height="{DynamicResource Mutable_AppItemCellHeight}" />

                            <DockPanel Grid.Column="1"
                                       Grid.ColumnSpan="2"
                                       Margin="0,4,12,-4">
                                <!-- Output bus routing, e.g. A1 = speakers, B1 = virtual recording device. -->
                                <ItemsControl DockPanel.Dock="Right"
                                              Focusable="False"
                                              IsTabStop="False"
                                              ItemsSource="{Binding Routes}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <ToggleButton Content="{Binding Name}"
                                                          IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                          Style="{StaticResource RouteToggleStyle}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock VerticalAlignment="Center"
                                           Theme:Brush.Foreground="Text"
                                           FontSize="{StaticResource {x:Static SystemFonts.MessageFontSizeKey}}"
                                           Opacity="0.8"
                                           Text="{Binding DisplayName}"
                                           TextTrimming="CharacterEllipsis" />
                            </DockPanel>

                            <Button Grid.Row="1"
                                    Width="{DynamicResource Mutable_AppIconSize}"
                                    Height="{DynamicResource Mutable_AppIconSize}"
                                    Margin="{StaticResource DeviceOrAppIconMargin}"
                                    HorizontalAlignment="Center"
                                    Command="{Binding ToggleMute}"
                                    IsTabStop="False"
                                    Opacity="1"
                                    ToolTip="{Binding DisplayName}">
                                <Button.Style>
                                    <Style BasedOn="{StaticResource MuteButton}" TargetType="Button" />
                                </Button.Style>
                                <Button.Content>
                                    <TextBlock Theme:Brush.Foreground="{Binding (Theme:Brush.Foreground), RelativeSource={RelativeSource AncestorType=Button}}"
                                               FontSize="{DynamicResource Mutable_DeviceVolumeTextFontSize}">
                                        <TextBlock.Style>
                                            <Style BasedOn="{StaticResource GlyphTextBlockStyle}" TargetType="TextBlock">
                                                <!-- Microphone for hardware inputs, audio for virtual inputs, mute when muted. -->
                                                <Setter Property="Text" Value="&#xE720;" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsVirtual}" Value="True">
                                                        <Setter Property="Text" Value="&#xE8D6;" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                                        <Setter Property="Text" Value="&#xE74F;" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Button.Content>
                            </Button>

                            <ctl:VolumeSlider Grid.Row="1"
                                              Grid.Column="1"
                                              PeakValue1="{Binding PeakValue1}"
                                              PeakValue2="{Binding PeakValue2}"
                                              Value="{Binding Volume, Mode=TwoWay}">
                                <ctl:VolumeSlider.Style>
                                    <Style BasedOn="{StaticResource {x:Type Slider}}" TargetType="Slider">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                                <Setter Property="Opacity" Value="{StaticResource MutedOpacity}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ctl:VolumeSlider.Style>
                            </ctl:VolumeSlider>

                            <TextBlock Grid.Row="1"
                                       Grid.Column="2"
                                       Text="{Binding Volume, Mode=OneWay, Converter={StaticResource VolumeToStringConverter}}">
                                <TextBlock.Style>
                                    <Style BasedOn="{StaticResource AppVolumeTextStyle}" TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                                <Setter Property="Opacity" Value="{StaticResource MutedOpacity}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
</UserControl>
